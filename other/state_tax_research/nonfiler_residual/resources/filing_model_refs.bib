@techreport{mok2017nonfilers,
  author      = {Mok, Shannon},
  title       = {An Evaluation of Using Linked Survey and Administrative Data to
                 Impute Nonfilers to the Population of Tax Return Filers},
  institution = {Congressional Budget Office},
  type        = {Working Paper},
  number      = {2017-06},
  year        = {2017},
  month       = {sep},
  url         = {https://www.cbo.gov/publication/53125},
  note        = {RECOMMENDED REPLACEMENT for Cilke (1998). Table 14 (pp. 48-50) gives
                 14 group-specific filing probits with coefficients and standard errors,
                 estimated on the 2007 CPS ASEC linked to the IRS Individual Master
                 File for TY2006. VERIFIED against the PDF 2026-08-18. PDF COMMITTED
                 BESIDE THIS FILE as mok2017_cbo_wp2017-06.pdf (md5
                 eb649ef0c5918ad0571b2005dc1d2437) because cbo.gov returns 403 to
                 automated retrieval; also in the Affordability literature folder at
                 Literature/Reweighting/53125-nonfilers.pdf.
                 TRANSCRIBED 2026-08-19 to mok_coefs.csv (14 groups x 17 terms),
                 verified page by page by ../11_verify_coef_transcriptions.py. A THIRD
                 irregularity the warnings below missed: Panel E has NO "Retirement
                 income" row at all, so its equations carry 15 covariates, not 16.
                 TRANSCRIPTION WARNINGS: Panel E columns run
                 "Age 65 or Older" FIRST then "Under Age 65" (reverse of the intuitive
                 order, and text extraction returns the headers reversed) -- transcribe
                 from a rendered image. Her CPS frame EXCLUDES the institutionalized and
                 military-barracks populations, so the coefficients do not cover the
                 group-quarters records our PUF universe includes}
}

